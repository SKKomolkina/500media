{
  "format": "custom",
  "id": "article",
  "label": "Article",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Заголовок (до 2 строк)"
        }
      },
      "author": {
        "type": "Text",
        "config": {
          "label": "Авторство"
        }
      },
      "lead": {
        "type": "StructuredText",
        "config": {
          "label": "Вводный текст",
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "tier": {
        "type": "Select",
        "config": {
          "label": "Уровень",
          "options": [
            "basic",
            "accent",
            "priority"
          ],
          "default_value": "basic"
        }
      },
      "weight": {
        "type": "Select",
        "config": {
          "label": "Важность Basic",
          "options": [
            "high",
            "medium",
            "low"
          ],
          "default_value": "medium"
        }
      },
      "pinned": {
        "type": "Boolean",
        "config": {
          "label": "Закрепить",
          "default_value": false
        }
      },
      "position": {
        "type": "Number",
        "config": {
          "label": "Порядок (меньше — выше)"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Категория",
          "options": [
            "hardware",
            "games",
            "ai"
          ]
        }
      },
      "image": {
        "type": "Image",
        "config": {
          "label": "Изображение",
          "constraint": {},
          "thumbnails": []
        }
      },
      "is_video": {
        "type": "Boolean",
        "config": {
          "label": "Видео (иконка Play)",
          "default_value": false
        }
      },
      "likes": {
        "type": "Number",
        "config": {
          "label": "Лайки"
        }
      },
      "reposts": {
        "type": "Number",
        "config": {
          "label": "Репосты"
        }
      },
      "video": {
        "type": "Link",
        "config": {
          "label": "Видеофайл (для ленты видео)",
          "select": "media",
          "allowText": false
        }
      },
      "summary": {
        "type": "StructuredText",
        "config": {
          "label": "Описание для видео (раскрывается по свайпу)",
          "multi": "paragraph,strong,em,hyperlink"
        }
      },
      "related": {
        "type": "Group",
        "config": {
          "label": "Связанные материалы",
          "fields": {
            "article": {
              "type": "Link",
              "config": {
                "label": "Материал",
                "select": "document",
                "customtypes": [
                  "article"
                ]
              }
            }
          }
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Содержимое статьи",
        "config": {
          "choices": {
            "text_section": {
              "type": "SharedSlice"
            },
            "image_slider": {
              "type": "SharedSlice"
            }
          }
        }
      }
    }
  }
}