{
  "id": "article",
  "label": "Article",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": { "type": "UID", "config": { "label": "UID" } },
      "title": { "type": "Text", "config": { "label": "Заголовок (до 2 строк)" } },
      "tier": { "type": "Select", "config": { "label": "Уровень", "options": ["basic", "accent", "priority"], "default_value": "basic" } },
      "weight": { "type": "Select", "config": { "label": "Важность Basic", "options": ["high", "medium", "low"], "default_value": "medium" } },
      "pinned": { "type": "Boolean", "config": { "label": "Закрепить", "default_value": false } },
      "position": { "type": "Number", "config": { "label": "Порядок (меньше — выше)" } },
      "category": { "type": "Select", "config": { "label": "Категория", "options": ["hardware", "games", "ai"] } },
      "image": { "type": "Image", "config": { "label": "Изображение", "constraint": {}, "thumbnails": [] } },
      "is_video": { "type": "Boolean", "config": { "label": "Видео (иконка Play)", "default_value": false } },
      "likes": { "type": "Number", "config": { "label": "Лайки" } },
      "reposts": { "type": "Number", "config": { "label": "Репосты" } }
    }
  }
}
