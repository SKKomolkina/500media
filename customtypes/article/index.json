{
  "format": "custom",
  "id": "article",
  "json": {
    "Main": {
      "uid": {
        "config": {
          "label": "UID"
        },
        "type": "UID"
      },
      "title": {
        "config": {
          "label": "Заголовок (до 2 строк)"
        },
        "type": "Text"
      },
      "author": {
        "config": {
          "label": "Авторство"
        },
        "type": "Text"
      },
      "lead": {
        "config": {
          "label": "Вводный текст",
          "multi": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "tier": {
        "config": {
          "default_value": "basic",
          "label": "Уровень",
          "options": [
            "basic",
            "accent",
            "priority"
          ]
        },
        "type": "Select"
      },
      "weight": {
        "config": {
          "default_value": "medium",
          "label": "Важность Basic",
          "options": [
            "high",
            "medium",
            "low"
          ]
        },
        "type": "Select"
      },
      "pinned": {
        "config": {
          "default_value": false,
          "label": "Закрепить"
        },
        "type": "Boolean"
      },
      "position": {
        "config": {
          "label": "Порядок (меньше — выше)"
        },
        "type": "Number"
      },
      "category": {
        "config": {
          "label": "Категория",
          "options": [
            "hardware",
            "games",
            "ai"
          ]
        },
        "type": "Select"
      },
      "image": {
        "config": {
          "constraint": {},
          "label": "Изображение",
          "thumbnails": []
        },
        "type": "Image"
      },
      "is_video": {
        "config": {
          "default_value": false,
          "label": "Видео (иконка Play)"
        },
        "type": "Boolean"
      },
      "likes": {
        "config": {
          "label": "Лайки"
        },
        "type": "Number"
      },
      "reposts": {
        "config": {
          "label": "Репосты"
        },
        "type": "Number"
      },
      "video": {
        "config": {
          "allowText": false,
          "label": "Видеофайл (для ленты видео)",
          "select": "media"
        },
        "type": "Link"
      },
      "summary": {
        "config": {
          "label": "Описание для видео (раскрывается по свайпу)",
          "multi": "paragraph,strong,em,hyperlink"
        },
        "type": "StructuredText"
      },
      "related": {
        "config": {
          "fields": {
            "article": {
              "config": {
                "customtypes": [
                  "article"
                ],
                "label": "Материал",
                "select": "document"
              },
              "type": "Link"
            }
          },
          "label": "Связанные материалы"
        },
        "type": "Group"
      },
      "slices": {
        "config": {
          "choices": {
            "text_section": {
              "type": "SharedSlice"
            },
            "image_slider": {
              "type": "SharedSlice"
            }
          }
        },
        "fieldset": "Содержимое статьи",
        "type": "Slices"
      }
    }
  },
  "label": "Article",
  "repeatable": true,
  "status": true
}